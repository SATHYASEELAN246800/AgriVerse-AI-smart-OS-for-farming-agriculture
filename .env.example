# AgriVerse AI Configuration - Environment Variables
# Copy this file to .env.local for development or .env for production

# ============================================
# BACKEND CONFIGURATION
# ============================================

# API Server Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Local LLM (Ollama) Configuration
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen:latest

# Database Configuration
# Use relative paths or absolute paths based on deployment
DB_BASE_PATH=./data/databases

# Model Directory (Hugging Face Models)
# Can be relative to project root or absolute path
MODELS_BASE_PATH=./models/huggingface
CROP_DOCTOR_MODELS_PATH=./agriculture_models

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Frontend Port
VITE_PORT=3000
VITE_HOST=localhost

# API Endpoints (for frontend proxy)
VITE_API_BACKEND=http://localhost:8000
VITE_API_OLLAMA=http://localhost:11434

# ============================================
# APPLICATION SETTINGS
# ============================================

# Default User (for demo/testing purposes - NEVER use in production)
VITE_DEFAULT_USER_EMAIL=farmer@agriverse.local
VITE_DEFAULT_USER_NAME=AgriVerse Farmer
VITE_DEFAULT_FARM_LOCATION=Tamil Nadu, India
VITE_DEFAULT_FARM_SIZE=10.0

# Application Mode
NODE_ENV=development
VITE_MODE=development

# ============================================
# LOGGING & DEBUGGING
# ============================================

# Debug Mode (set to true for development)
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# SECURITY (Production Only)
# ============================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_ENABLED=true

# API Key for external services (if any)
# EXTERNAL_API_KEY=your_api_key_here

# ============================================
# NOTES
# ============================================
# - Never commit .env files to version control
# - Use .env.local for development
# - Use .env for production (managed by deployment system)
# - All paths should be relative to project root for portability
